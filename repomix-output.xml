      - ./certs/ca.pem:/app/certs/ca.pem:ro
      - ./certs/client.pem:/app/certs/client.pem:ro
      - ./certs/client.key:/app/certs/client.key:ro
    depends_on: [coordinator]
    networks: [dsm-net]

networks:
  dsm-net: {}

volumes:
  coordinator-data: {}
