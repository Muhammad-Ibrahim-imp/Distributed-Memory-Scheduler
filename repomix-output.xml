<file path="memory_node/allocator/allocator.py">
class Allocator:
    """Tracks how much of this node's RAM budget is reserved. Counts bytes only;
    ObjectStore holds the data. No awaits here, so under asyncio a call can't be
    interrupted halfway by another request."""

    def __init__(self, total_capacity_bytes: int):
        if total_capacity_bytes <= 0:
            raise ValueError("total_capacity_bytes must be positive")
        self.total_capacity = total_capacity_bytes
        self.used = 0

    def reserve(self, size: int) -> bool:
        """False (and no change) if there is not enough room.
        node.py turns False into OutOfCapacityError."""
        if size < 0:
            raise ValueError("size must not be negative")
        if size > self.available():
            return False
        self.used += size
        return True

    def release(self, size: int) -> None:
        if size < 0:
            raise ValueError("size must not be negative")
        if size > self.used:
            # Releasing more than reserved means an accounting bug elsewhere.
            # Failing loudly beats hiding it by clamping at zero.
            raise ValueError("cannot release more than is reserved")
        self.used -= size

    def available(self) -> int:
        return self.total_capacity - self.used
</file>

<file path="memory_node/security/secure_delete.py">
class SecureDeleter:
    """Best-effort wipe. Python can't guarantee no other copies exist
    (for example the bytes object B1 passed into write() until it is
    garbage-collected), so this clears OUR buffer, not every copy."""

    def wipe(self, data: bytearray) -> bool:
        """Zeroes the buffer in place. True if every byte is zero afterwards.
        node.free reports SECURE_DELETE_FAILED (WARNING) when this returns False;
        the free still succeeds (M5)."""
        if not isinstance(data, bytearray):
            raise TypeError("only a bytearray can be wiped in place (bytes are immutable)")
        data[:] = bytes(len(data))
        return data.count(0) == len(data)
</file>

<file path="memory_node/storage/storage.py">
from common.types.errors import ObjectNotFoundError


class ObjectStore:
    """Holds each object's bytes. Buffers are bytearray so SecureDeleter can wipe them in place."""

    def __init__(self):
        self._data: dict[str, bytearray] = {}

    def put(self, object_id: str, data: bytes) -> None:
        """Stores a copy. Replaces any existing object (full replace, confirmed by A2).
        Week 3: write() should wipe the old buffer before replacing it (open item)."""
        self._data[object_id] = bytearray(data)

    def get(self, object_id: str) -> bytes:
        try:
            return bytes(self._data[object_id])
        except KeyError:
            raise ObjectNotFoundError(f"object {object_id} not found") from None

    def has(self, object_id: str) -> bool:
        return object_id in self._data

    def delete(self, object_id: str) -> bytearray:
        """Removes the object and returns its buffer, so the caller can wipe it."""
        try:
            return self._data.pop(object_id)
        except KeyError:
            raise ObjectNotFoundError(f"object {object_id} not found") from None
