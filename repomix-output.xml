<file path="network/security/rate_limit.py">
import time
from dataclasses import dataclass

CAPACITY = 20
REFILL_PER_SECOND = 5.0


@dataclass
class _Bucket:
    tokens: float
    last: float


class RateLimiter:
    def __init__(self, capacity: int = CAPACITY,
                 refill_per_second: float = REFILL_PER_SECOND,
                 clock=time.time):
        self.capacity = capacity
        self.refill = refill_per_second
        self.clock = clock
        self._buckets: dict[str, _Bucket] = {}

    def check(self, identity: str) -> bool:
        now = self.clock()
        b = self._buckets.get(identity)
        if b is None:
            self._buckets[identity] = _Bucket(tokens=self.capacity - 1, last=now)
            return True
        elapsed = now - b.last
        b.tokens = min(self.capacity, b.tokens + elapsed * self.refill)
        b.last = now
        if b.tokens < 1.0:
            return False
        b.tokens -= 1.0
        return True
</file>

<file path="network/security/replay.py">
import time
from dataclasses import dataclass

WINDOW_SECONDS = 60
SKEW_SECONDS = 5


@dataclass
class ReplayResult:
    ok: bool
    reason: str = ""


class ReplayGuard:
    def __init__(self, window_seconds: int = WINDOW_SECONDS,
                 skew_seconds: int = SKEW_SECONDS,
                 clock=time.time):
        self.window = window_seconds
        self.skew = skew_seconds
        self.clock = clock
        self._seen: dict[tuple[str, str], float] = {}

    def check(self, identity: str, nonce: str, timestamp: float) -> ReplayResult:
        now = self.clock()
        # Sweep FIRST so an entry that has aged out is not falsely flagged.
        self._sweep(now)
        if abs(now - timestamp) > self.window + self.skew:
            return ReplayResult(False, "timestamp_out_of_window")
        key = (identity, nonce)
        if key in self._seen:
            return ReplayResult(False, "replay_detected")
        self._seen[key] = now
        return ReplayResult(True)

    def _sweep(self, now: float) -> None:
        cutoff = now - (self.window + self.skew)
        for key, t in list(self._seen.items()):
            if t < cutoff:
                del self._seen[key]
