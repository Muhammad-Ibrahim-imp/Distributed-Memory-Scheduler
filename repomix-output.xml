    command: python scripts/coordinator_main.py
    environment:
      SERVICE_ROLE: coordinator
      SECURITY_PORT: "8443"
      DSM_TOKEN_KEY: ${DSM_TOKEN_KEY:-}      
      DSM_NODE_ENROLLMENT_SECRET: ${DSM_NODE_ENROLLMENT_SECRET:?set DSM_NODE_ENROLLMENT_SECRET in .env}
      DSM_CLIENT_ENROLLMENT_SECRET: ${DSM_CLIENT_ENROLLMENT_SECRET:?set DSM_CLIENT_ENROLLMENT_SECRET in .env}
    ports:
      - "8443:8443"
    volumes:
      - ./configs:/app/configs:ro
      - ./certs/ca.pem:/app/certs/ca.pem:ro
      - ./certs/server.pem:/app/certs/server.pem:ro
      - ./certs/server.key:/app/certs/server.key:ro
      - coordinator-data:/app/data
    networks: [dsm-net]

  node:
    build: .
    command: python scripts/node_main.py
    environment:
      SERVICE_ROLE: node
      SECURITY_HOST: coordinator
      SECURITY_PORT: "8443"
      DSM_NODE_ENROLLMENT_SECRET: ${DSM_NODE_ENROLLMENT_SECRET:?set DSM_NODE_ENROLLMENT_SECRET in .env}
      NODE_ID: "node-1"
      DSM_NODE_CERT_FILE: /app/certs/nodes/node-1.pem
      DSM_NODE_KEY_FILE: /app/certs/nodes/node-1.key
