    with pytest.raises(DSMTimeoutError):
        await MatrixMultiplicationAdapter(dsm, block_size=8).prepare((rand(40, 40), rand(40, 40)))
    assert dsm.live_ids == set()


async def test_execute_failure_frees_partial_outputs():
