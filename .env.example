# Set different secrets (at least 32 bytes each), e.g. generated with secrets.token_urlsafe(32).
DSM_NODE_ENROLLMENT_SECRET=
DSM_CLIENT_ENROLLMENT_SECRET=
DSM_TOKEN_KEY=

# Optional compute/container settings (Docker Compose defaults shown).
DSM_COMPUTE_SCHEDULER=locality
DSM_COMPUTE_ENABLED=true
NODE_3_COMPUTE_ENABLED=true
NODE_CAPACITY_BYTES=268435456
NODE_COMPUTE_SLOTS=1
NODE_COMPUTE_MEMORY_BYTES=67108864
NODE_CONTAINER_MEMORY_LIMIT=512m
NODE_CPU_LIMIT=2.0
COORDINATOR_MEMORY_LIMIT=1g
COORDINATOR_CPU_LIMIT=2.0
